# Copy this file to .env and adjust values. .env is gitignored — never commit it.

# --- Django ----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-value-in-every-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL --------------------------------------------------------------
# Consumed directly by the postgres container.
POSTGRES_DB=bella
POSTGRES_USER=bella
POSTGRES_PASSWORD=bella

# Consumed by Django (django-environ). Host/port here are the in-network
# service name and port ("db"/5432) — always the same regardless of what
# host port db is published on below. Must describe the same database as
# the POSTGRES_* values above.
DATABASE_URL=postgres://bella:bella@db:5432/bella

# --- Redis / Celery ----------------------------------------------------------
# Same note as above: "redis"/6379 is the in-network address, independent of
# the host port published below.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Separate logical DB from the broker/result-backend above so DRF throttle
# keys never collide with Celery's own (docs/DECISIONS.md § Stage 3 decisions).
REDIS_CACHE_URL=redis://redis:6379/2

# --- Host port mapping --------------------------------------------------------
# Only affects which port is exposed on your machine — change these if the
# defaults collide with another project's containers. Services still talk to
# each other over the compose network using the standard ports above.
HOST_DB_PORT=5432
HOST_REDIS_PORT=6379
HOST_BACKEND_PORT=8000
HOST_FRONTEND_PORT=3000
FRONTEND_URL=http://{slug}.localhost:3000