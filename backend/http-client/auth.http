### Bella backend — Stage 3 auth endpoints (PyCharm HTTP Client)
#
# Run against the local stack: docker compose up (HOST_BACKEND_PORT=8001 in .env).
# Registration/verification/reset emails print to stdout in dev — watch them with:
#   docker compose logs -f celery_worker
#
# Login and Refresh below capture their tokens into client.global variables
# (accessToken / refreshToken) so Logout and the authenticated requests that
# follow can reuse them without copy-pasting. Verify Email and Password Reset
# Confirm need a token/uid pasted in from the console-logged email — there's
# no way to capture those automatically since they only exist in the mail body.

@baseUrl = http://localhost:8001
@salonSlug = bella-demo
@email = pycharm-test@example.com
@password = a-genuinely-strong-passw0rd!

### Register
# Expected 202 Accepted, identical whether or not `email` is already
# registered (docs/DECISIONS.md § Stage 3 decisions — no enumeration):
# {
#   "detail": "If this email can be registered, check your inbox to continue."
# }
POST {{baseUrl}}/api/v1/auth/register/
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login
# Expected 200 OK:
# {
#   "refresh": "<jwt>",
#   "access": "<jwt>"
# }
# Only works once the account above is created (registration doesn't require
# email verification to log in — docs/ARCHITECTURE.md § 3).
POST {{baseUrl}}/api/v1/salons/{{salonSlug}}/auth/login/
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.global.set("accessToken", response.body.access);
    client.global.set("refreshToken", response.body.refresh);
%}

### Refresh
# Expected 200 OK — ROTATE_REFRESH_TOKENS is on, so this returns a *new*
# refresh token too, and the one just used stops working (blacklisted):
# {
#   "access": "<jwt>",
#   "refresh": "<jwt>"
# }
POST {{baseUrl}}/api/v1/salons/{{salonSlug}}/auth/refresh/
Content-Type: application/json

{
  "refresh": "{{refreshToken}}"
}

> {%
    client.global.set("accessToken", response.body.access);
    client.global.set("refreshToken", response.body.refresh);
%}

### Logout
# Expected 205 Reset Content, empty body. Requires a valid access token
# (LogoutView has no permission_classes of its own — it relies on the
# project-wide IsAuthenticated default, docs/DECISIONS.md § Stage 3
# decisions). Blacklists the refresh token; a second Refresh with the same
# token afterward returns 401.
POST {{baseUrl}}/api/v1/salons/{{salonSlug}}/auth/logout/
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "refresh": "{{refreshToken}}"
}

### Password reset — request
# Expected 202 Accepted, identical whether or not `email` is registered
# (docs/DECISIONS.md § Stage 3 decisions — no enumeration):
# {
#   "detail": "If this email is registered, check your inbox for a reset link."
# }
POST {{baseUrl}}/api/v1/auth/password-reset/
Content-Type: application/json

{
  "email": "{{email}}"
}

### Password reset — confirm
# Expected 200 OK:
# {
#   "detail": "Password reset."
# }
# `uid`/`token` come from the link in the console-logged reset email
# (.../reset-password#uid=...&token=...) — paste them in below.
POST {{baseUrl}}/api/v1/auth/password-reset/confirm/
Content-Type: application/json

{
  "uid": "PASTE_UID_FROM_EMAIL",
  "token": "PASTE_TOKEN_FROM_EMAIL",
  "new_password": "an-even-stronger-passw0rd!"
}

### Resend verification email
# Expected 202 Accepted, identical whether or not `email` exists / still
# needs verifying (docs/DECISIONS.md § Stage 3 decisions — no enumeration):
# {
#   "detail": "If this email needs verifying, check your inbox."
# }
POST {{baseUrl}}/api/v1/auth/resend-verification/
Content-Type: application/json

{
  "email": "{{email}}"
}

### Verify email
# Expected 200 OK:
# {
#   "detail": "Email verified."
# }
# `token` comes from the link in the console-logged verification email
# (.../verify-email#token=...) — paste it in below. Verifying twice with the
# same token is a safe no-op (still 200), not an error.
POST {{baseUrl}}/api/v1/auth/verify-email/
Content-Type: application/json

{
  "token": "PASTE_TOKEN_FROM_EMAIL"
}
