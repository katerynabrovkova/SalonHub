# Copy this file to .env.local (or .env) and adjust values.
# Only NEXT_PUBLIC_* vars are exposed to browser code.

# Base URL of the backend API. Set the port to match your HOST_BACKEND_PORT
# from the repo-root .env (the value below is the repo default). No trailing
# slash — the API client appends /api/v1/salons/<slug><path>.
NEXT_PUBLIC_API_URL=http://localhost:8000
