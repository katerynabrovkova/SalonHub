# Copy this file to .env.local (or .env) and adjust values.
# Only NEXT_PUBLIC_* vars are exposed to browser code.

# Base URL of the backend API, used only by the browser-side guest-token
# helpers (guestClient.ts / createGuestBooking.ts) that send no cookies and
# so are not subject to SameSite cookie policy. Set the port to match your
# HOST_BACKEND_PORT from the repo-root .env (the value below is the repo
# default). No trailing slash — appends /api/v1/salons/<slug><path>.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Port the cookie-authenticated apiRequest() (api/client.ts) reaches the
# backend on. Unlike NEXT_PUBLIC_API_URL above, apiRequest builds its base
# URL from the CURRENT PAGE's own window.location.hostname at call time, not
# a fixed host here — only the port is configurable (docs/DECISIONS.md §
# "Dev environment: API hostname breaks the same-site assumption"). A fixed
# host (bare "localhost", or even a separate "api.localhost") can never be
# the same registrable domain as every per-tenant "<slug>.localhost"
# frontend, so SameSite=Lax cookies (csrftoken/access_token/refresh_token)
# would be silently dropped by the browser on apiRequest's fetch() calls.
# Mirroring the page's own hostname and only swapping the port keeps the API
# call genuinely same-site regardless of which salon subdomain is active.
NEXT_PUBLIC_API_PORT=8000

# Base URL for server-side fetches only (Server Components, route handlers).
# No NEXT_PUBLIC_ prefix — never inlined into the client bundle, and must not
# be read by browser code. Set to the backend's Compose service name
# (http://backend:8000), the in-network DNS address that resolves
# container-to-container regardless of HOST_BACKEND_PORT — unlike
# NEXT_PUBLIC_API_URL's host-published localhost:PORT, "localhost" inside the
# frontend container means the frontend container itself, not the backend.
INTERNAL_API_URL=http://backend:8000

# Platform domain — each tenant is served from <slug>.<PLATFORM_DOMAIN>. The
# middleware reads the subdomain from the Host header to resolve the active
# salon slug. Must match the backend's PLATFORM_DOMAIN (repo-root .env).
# "salonhub.com" is a placeholder, not a confirmed purchased domain.
# Middleware runs server-side and would accept a non-prefixed PLATFORM_DOMAIN,
# but NEXT_PUBLIC_ is used so client components can read the same value.
NEXT_PUBLIC_PLATFORM_DOMAIN=salonhub.com
