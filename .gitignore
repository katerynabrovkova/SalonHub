# Repo-wide ignores only.
# Python / Django patterns live in backend/.gitignore;
# Node / Next.js patterns live in frontend/.gitignore.

# OS files
.DS_Store
Thumbs.db

# Logs (repo-wide safety net; backend/ and frontend/ also ignore their own)
*.log

# Editors / IDEs
.idea/
.vscode/

# Local environment
#   The repo-root .env is read by docker-compose (see .env.example, which is
#   committed). Per-service .env files are ignored by their own .gitignore.
.env
